---
import type { PlayerCardData } from '@/data/players';
import { playerCardData } from '@/data/players';
---

<div
  id="slider-wrapper"
  class="w-full h-screen flex flex-col md:flex-row"
>
  <!-- Texto -->
  <div class="w-full md:w-1/2 lg:w-2/5 flex-none flex flex-col items-center justify-center p-4 md:p-8 md:order-2">
    <h2 class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl text-center md:text-left font-black italic text-secondary uppercase">
      Con quien quieras
    </h2>
    <p class="mt-2 text-md sm:text-lg md:text-xl lg:text-2xl italic text-center md:text-left text-gray-500">
      Elige a tus compañeros, o deja que el sistema te sugiera tus compañeros ideales
    </p>
  </div>

  <!-- Slider -->
  <div class="relative flex-1 md:w-1/2 lg:w-3/5 md:order-1">
    <section
      id="player-slider"
      class="w-full h-full overflow-hidden relative pt-8 pb-20"
    >
      <div class="slides flex will-change-transform h-full">
        {playerCardData.map((p: PlayerCardData, index: number) => (
          <div
            id={`player-card-${index}`}
            class="h-full mx-2 rounded-2xl shadow-2xl bg-cover bg-center relative flex flex-col justify-end p-4 sm:p-6 md:p-8 overflow-hidden"
            style={`background-image:url(${p.imageSrc})`}
          >
            <div class="relative z-10">
              <span class="block text-secondary font-bold text-3xl sm:text-4xl md:text-5xl leading-tight drop-shadow-lg">
                {p.title1}
              </span>
              <span class="block text-secondary font-bold text-3xl sm:text-4xl md:text-5xl leading-tight drop-shadow-lg">
                {p.title2}
              </span>
            </div>
            <span class="absolute inset-0 bg-gradient-to-t from-black/75 via-black/40 to-transparent"></span>
          </div>
        ))}
      </div>
    </section>
  </div>
</div>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener("DOMContentLoaded", () => {
    const wrapper = document.getElementById("slider-wrapper");
    const slider  = document.getElementById("player-slider");
    const track   = slider.querySelector(".slides");
    const slides  = Array.from(track.children);
    const total   = slides.length;

    // 1) Ajustamos anchura del track
    track.style.width = `${total * 100}%`;
    slides.forEach(slide => {
      slide.style.flex = `0 0 ${100 / total}%`;
    });

    // 2) Calculamos desplazamiento total en porcentaje
    const movePercent = -100 * (total - 1) / total;

    // 3) Longitud de scroll proporcional al número de slides
    const scrollDistance = slider.offsetWidth * (total - 1);

    // 4) Reservamos espacio bajo el wrapper para no solapar contenido
    wrapper.style.marginBottom = `${scrollDistance}px`;

    // 5) ScrollTrigger: pinnea el wrapper completo
    gsap.to(track, {
      xPercent: movePercent,
      ease: "none",
      scrollTrigger: {
        trigger: wrapper,
        start:   "top top",
        end:     `+=${scrollDistance}`,
        scrub:   1,
        pin:     true,
        pinSpacing: false
      },
    });
  });
</script>